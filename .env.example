# Public deployment URL (required for the production deployment)
NEXT_PUBLIC_SITE_URL=https://blog.pieroot.xyz

# HAProxy-reachable Mac address. Set 127.0.0.1 only when HAProxy runs natively on this Mac.
BLOG_BIND_ADDRESS=

# Notion Configuration (REQUIRED)
# Get these values from your Notion workspace

# Required: Notion Integration Token
# Get your token at: https://www.notion.so/my-integrations
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxx

# Required: Notion DataSource ID (with hyphens)
# This is the data_source ID in UUID format
NOTION_DATASOURCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Google Analytics (Optional)
NEXT_PUBLIC_GOOGLE_MEASUREMENT_ID=

# Google Search Console (Optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Naver Search Advisor (Optional)
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# Notion Comments (Optional — enable in site.config.js notionComments.enable)
# The data_source ID of a Notion database shared with your integration (see README for schema)
# To find your data_source ID: call GET /v1/databases/{database_id} and copy data_sources[0].id
NOTION_COMMENTS_DATASOURCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Salt for IP/nickname hashing — generate with: openssl rand -hex 32
COMMENT_HASH_SALT=

# Notion Visitor Stats (Optional — unique page visits)
# The data_source ID of a Notion visit-stats database shared with your integration
NOTION_VISIT_STATS_DATASOURCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Salt for visitor-cookie hashing — generate with: openssl rand -hex 32
VISITOR_HASH_SALT=
# HAProxy is the one trusted reverse-proxy hop in the production deployment.
TRUSTED_PROXY_HOPS=1
# Shared credential HAProxy must overwrite into X-Monolog-Proxy-Secret.
# Generate with: openssl rand -hex 32
TRUSTED_PROXY_SECRET=

# Redis Cache (Optional — improves cold-start performance)
# Standard Redis connection URL. Examples:
#   Local:         redis://localhost:6379
#   With auth:     redis://default:password@host:6379
#   TLS:           rediss://default:password@host:6380
#   Specific DB:   redis://localhost:6379/2
# If not set, only in-process memory cache (L1) is used.
REDIS_URL=redis://localhost:6379         # Optional — Redis connection for L2 cache

# Cache namespace prefix for Redis keys (Optional, default: monolog)
# Change per deployment (staging, preview) to avoid key collisions on a shared Redis instance.
# CACHE_NAMESPACE=monolog

# Utterances Comments (Optional)
NEXT_PUBLIC_UTTERANCES_REPO=

# Revalidate API Token (required for Docker Compose; optional outside Compose)
# Used to protect /api/revalidate, /api/init, /api/cron/graph.
# Must match the REVALIDATE_SECRET GitHub Actions secret (if using the workflow).
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# ISR revalidation interval in hours for Docker Compose
REVALIDATE_HOURS=1

# LLM Ontology + Vector Search (Optional — required for /ontology, Graph semantic overlay, and RightRail "ai · similar")
# Anthropic API key for entity/relation extraction (Claude Haiku 4.5)
ANTHROPIC_API_KEY=
# OpenAI API key for text embeddings (text-embedding-3-small)
OPENAI_API_KEY=
# Qdrant REST endpoint. Used first for persisted graph snapshots, and also by ontology/vector search.
# Local dev with a host Qdrant: http://localhost:6333. Docker Compose uses http://qdrant:6333 inside docker-compose.yml.
QDRANT_URL=http://localhost:6333
# Qdrant API key — leave empty for local/self-hosted without auth
QDRANT_API_KEY=
# Maximum time for a complete Notion graph build before it is treated as partial (default: 120000, max: 300000)
GRAPH_BUILD_TIMEOUT_MS=120000
