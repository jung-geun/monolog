# Required: create .env, fill only these two values, then run yarn setup.
# Get an integration token at https://www.notion.so/my-integrations and share
# the original source database with the integration (read-content capability).
NOTION_TOKEN=
# A data-source UUID works directly. During setup you may instead paste a copied
# HTTPS Notion database URL here: yarn setup resolves it through the Notion API
# and replaces it with the data-source UUID. For multiple sources, setup lists
# names/IDs and asks you to set the intended data-source UUID explicitly.
NOTION_DATASOURCE_ID=

# Set your own public origin BEFORE building for deployment. Native dev default:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Durable single-host content storage for native development.
# Compose automatically uses its private AOF-backed content Redis instead.
CONTENT_STATE_DIR=.content-state

# Generated by yarn setup when blank; never rotated on rerun. Required by Compose.
# Protects /api/revalidate, /api/init and the content/graph/ontology cron endpoints.
# Match the GitHub Actions secret if using scheduled workflows.
REVALIDATE_SECRET=

# Optional analytics / site verification (runtime configuration supported).
# NEXT_PUBLIC_GOOGLE_MEASUREMENT_ID=
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional AdSense / Utterances (set BEFORE source image builds).
# Manual ads require your own client + real display unit ID(s), and Auto ads OFF in AdSense.
# The confirmation below is an operator assertion, NOT an account-setting API.
# Without all prerequisites the SDK and manual slots remain disabled.
# NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=
# NEXT_PUBLIC_GOOGLE_ADSENSE_DISABLE=false
# NEXT_PUBLIC_GOOGLE_ADSENSE_ARTICLE_SLOT=
# NEXT_PUBLIC_GOOGLE_ADSENSE_POST_BOTTOM_SLOT=
# NEXT_PUBLIC_GOOGLE_ADSENSE_AUTO_ADS_DISABLED_CONFIRMED=false
# NEXT_PUBLIC_UTTERANCES_REPO=

# Optional Notion comments: opt in BEFORE source image builds.
# Configure an explicit data-source UUID, not a database URL. When this ID is
# configured, yarn setup generates COMMENT_HASH_SALT only if blank/missing.
# NOTION_COMMENTS_DATASOURCE_ID=
# NEXT_PUBLIC_NOTION_COMMENTS_ENABLE=true
# COMMENT_HASH_SALT=

# Optional visitor stats: configure an explicit data-source UUID.
# yarn setup generates an independent VISITOR_HASH_SALT only if blank/missing.
# NOTION_VISIT_STATS_DATASOURCE_ID=
# VISITOR_HASH_SALT=

# Optional trusted proxy: direct requests are the default (zero trusted hops).
# Only opt in when your proxy overwrites X-Monolog-Proxy-Secret with a strong
# shared secret; app origin/proxy authentication checks remain enforced.
# TRUSTED_PROXY_HOPS=0
# TRUSTED_PROXY_SECRET=
# BLOG_BIND_ADDRESS=127.0.0.1 # Only for a machine-local port-binding override.

# Optional cache / content settings. Compose supplies REDIS_URL,
# CONTENT_REDIS_URL, QDRANT_URL and EMBEDDING_SERVICE_URL on its private network.
# Native dev needs no cache Redis; memory cache is used when REDIS_URL is absent.
# REDIS_URL=redis://localhost:6379
# CACHE_NAMESPACE=monolog
# CONTENT_REDIS_URL=redis://localhost:6380 # Alternative to CONTENT_STATE_DIR; Redis 7.2+ with AOF.
# CONTENT_NAMESPACE=monolog
# CONTENT_LOCK_MS=900000
# REVALIDATE_HOURS=6 # Source build-time ISR interval; positive integer hours.
# GRAPH_BUILD_TIMEOUT_MS=120000 # Maximum 300000.

# Optional semantic features: Meaning / similar-post matching use local text
# embeddings and Qdrant, NOT Anthropic. Compose supplies both services; no API
# key is needed for the fixed public google/embeddinggemma-2 embedding model.
# Native dev can point these at separately running services (not required):
# EMBEDDING_SERVICE_URL=http://localhost:8000
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Optional Anthropic: Claude entity/relation extraction for ontology only.
# ANTHROPIC_API_KEY=

# Optional Notion webhook: subscribe your site's /api/notion-webhook endpoint,
# copy verification_token from the server log into Notion's Verify form, then
# set it here. Scheduled /api/cron/content remains authoritative.
# NOTION_WEBHOOK_VERIFICATION_TOKEN=
# DISCORD_WEBHOOK= # Optional rejection notifications.

# Optional IndexNow: hexadecimal key, 8–128 characters (openssl rand -hex 16).
# Served at /<key>.txt; changed public URLs are submitted after publication.
# INDEXNOW_KEY=
# INDEXNOW_KEY_LOCATION= # Optional absolute URL of your hosted key file.
