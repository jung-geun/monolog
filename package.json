{
  "name": "monolog",
  "version": "1.17.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jung-geun/monolog.git"
  },
  "scripts": {
    "dev": "nice -n 10 next dev --webpack",
    "prebuild": "rm -f public/sitemap.xml public/sitemap-*.xml",
    "build": "next build --webpack",
    "start": "next start",
    "warm:graph": "curl -fsS \"http://localhost:${PORT:-3000}/graphs/notion-graph.json\" -o /dev/null -w 'graph warmed: HTTP %{http_code} in %{time_total}s\\n'",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@notionhq/client": "^5.22.0",
    "@radix-ui/colors": "^2.1.0",
    "@tanstack/react-query": "^5.101.2",
    "@types/katex": "^0.16.7",
    "caniuse-lite": "^1.0.30001799",
    "cookies-next": "^5.1.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dotenv": "^17.2.3",
    "ioredis": "^5.11.1",
    "katex": "^0.17.0",
    "lru-cache": "^11.5.1",
    "mermaid": "^11.16.0",
    "next": "^16.2.9",
    "notion-types": "^7.10.0",
    "notion-utils": "^7.10.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "react-notion-x": "^7.10.0",
    "zod": "^4.4.3"
  },
  "resolutions": {
    "postcss": "^8.5.16",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
