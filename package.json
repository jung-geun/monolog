    "autoprefixer": "^10.5.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.9",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.16",
    "prettier": "^3.9.3",
